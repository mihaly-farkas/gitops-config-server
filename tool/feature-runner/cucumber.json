{
  "default": {
    "requireModule": [
      "tsx"
    ],
    "require": [
      "cucumber/**/*.ts",
      "steps/**/*.ts"
    ],
    "paths": [
      "feature/**/*.feature"
    ],
    "format": [
      [
        "progress"
      ],
      [
        "html",
        "reports/cucumber-report.html"
      ]
    ]
  }
}
