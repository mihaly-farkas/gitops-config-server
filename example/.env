# The URI of the Git repository containing your configuration files.
# This property is mandatory.
CONFIG_GIT_URI=

# The username for accessing the Git repository.
# This property is mandatory if the repository is private.
CONFIG_GIT_USERNAME=

# The password or personal access token for accessing the Git repository.
# This property is mandatory if the repository is private.
CONFIG_GIT_PASSWORD=

# The encryption key used for encrypting and decrypting sensitive configuration values.
# This property is mandatory if you are using encrypted values in your configuration files.
CONFIG_ENCRYPTION_KEY=

# The username for accessing the Spring Cloud Config Server.
# This property is mandatory.
SPRING_SECURITY_USER_NAME=

# The password for accessing the Spring Cloud Config Server.
# This property is mandatory.
SPRING_SECURITY_USER_PASSWORD=

