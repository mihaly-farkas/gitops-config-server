# The URI of the Git repository containing your configuration files.
# This property is mandatory.
CONFIG_GIT_URI=https://github.com/mihaly-farkas/gitops-config-server

# The search paths within the Git repository where your configuration files are located.
# If not specified, the root of the repository will be used.
CONFIG_GIT_SEARCH_PATHS=example/config

# The username for accessing the Git repository.
# This property is mandatory if the repository is private.
# CONFIG_GIT_USERNAME=

# The password or personal access token for accessing the Git repository.
# This property is mandatory if the repository is private.
# CONFIG_GIT_PASSWORD=

# The password for the keystore containing the encryption key.
# This property is mandatory if you are using encrypted values in your configuration files.
CONFIG_ENCRYPTION_KEYSTORE_PASSWORD=ChangeMe123!

# The location of the keystore file containing the encryption key.
# Mandatory if you want to run the Spring Boot application outside of the Docker container.
# If not specified, the keystore will be generated at runtime inside the Docker container.
CONFIG_ENCRYPTION_KEYSTORE_LOCATION=file:.local/configserver.p12

# The username for accessing the GitOps Config Server.
# This property is mandatory.
ADMIN_USER_NAME=admin

# The password for accessing the GitOps Config Server.
# This property is mandatory.
ADMIN_PASSWORD=ChangeMe123!

